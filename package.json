{
  "name": "lawyer-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173 --strictPort",
    "build": "tsc --noEmit && vite build && vite build --ssr ../src/entry-server.tsx --outDir ../.prerender && node scripts/finalize-build.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "pages:sync": "node scripts/sync-pages.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@hookform/resolvers": "^3.3.2",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.47.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "postcss": "^8.4.31",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "minimatch@9.0.3": "9.0.9"
  }
}
